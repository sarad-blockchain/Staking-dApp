ganache-cli.db
.ganache

# Hardhat / Foundry local node data
.hardhat/
hardhat-artifacts/

# Solidity documentation
docs/api/

# ==================== TEMPORARY FILES ====================
*.tmp
*.temp
*.bak
*.log
*.orig

# ==================== PACKAGE MANAGERS ====================
package-lock.json
yarn.lock
pnpm-lock.yaml

# ==================== BUILD & DEPLOY ARTIFACTS ====================
build/
dist/
*.wasm
*.wasm.js

# ==================== PRIVATE KEYS / SECRETS ====================
