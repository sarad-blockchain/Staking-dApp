# SkyStake Project - .gitignore
# Covers Solidity contracts (Foundry), Angular frontend, and general development

# ==================== ENVIRONMENT VARIABLES ====================
.env
.env.local
.env.*.local
.env.example

# ==================== FOUNDRY / SOLIDITY ====================
# Foundry cache and build artifacts
cache/
out/
broadcast/

# Foundry test results
.gas-snapshot

# Solidity compiler cache
*.sol.json
*.sol.abi.json

# ==================== NODE MODULES ====================
node_modules/
npm-debug.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ==================== ANGULAR / TYPESCRIPT ====================
# Angular build output
dist/
tmp/
out-tsc/
bazel-out/

# Angular dependencies
packages/frontend/node_modules
packages/contracts/node_modules

# Test coverage
coverage/
*.lcov
.nyc_output/

# IDEs cache
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# ==================== IDE / EDITOR FILES ====================
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/settings.json
!.vscode/tasks.json

.DS_Store
Thumbs.db

# Visual Studio
.vs/
*.user
*.suo
*.sln.docstates

# Sublime Text
*.sublime-project
*.sublime-workspace

# vim
*.swp
*.swo
*~
.vim/

# Emacs
*~
\#*\#
.\#*

# ==================== OS SPECIFIC ====================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

