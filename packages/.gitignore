# Foundry library remappings
remappings.txt
foundry.lock

# ==================== FRONTEND SPECIFIC ====================
# Angular CLI cache
.angular/
.angular/cache/

# Angular production build
dist/
*.js.map
*.css.map

# Angular test coverage
karma.conf.js

# ==================== DOCUMENTATION GENERATED ====================
docs/_build/
docs/.doctrees/
site/

# ==================== MISCELLANEOUS ====================
.firebaserc
.firebase/
.netlify
.vercel
.env.local
.vercel.json

# IDE specific
*.iml
*.iws
*.ipr

# MacOS workspace
.workspace

# Auto-generated API documentation
api-docs/

# Database files
*.sqlite
*.sqlite3
*.db

# ==================== GITHUB ====================
# GitHub-related files
.git
.gitkeep

# ==================== MONOREPO ====================
# Workspace-specific
lerna-debug.log*
.pnp
.pnp.js

# hoisting
.hoist

# Babel cache
.babel.json
babel-cache/

